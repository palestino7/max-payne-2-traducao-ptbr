# ==============================================================================
# Max Payne 2: The Fall of Max Payne — Tradução PT-BR (Definitiva v3.0.0)
# .gitignore
# ==============================================================================

# Binários pesados (> 100 MB limite do GitHub e pacotes compilados de distribuição)
*.exe
dist/*.exe
dist/*.zip
dist/*.ras
dist/*.mp2m
*.ras
*.mp2m
*.bak

# Scripts e arquivos temporários de raiz
/*.bat
/*.ps1
*.webp
README_*.txt
TEST_*.md

# Ferramentas externas e diretórios de dados temporários
tools/data/
tools/MaxPayne-Toolset/
tools/*.zip
tools/*.exe

# Diretórios de trabalho / descompactação intermediária / auditoria
concorrente/
extracted_data/
extracted_english/
extracted_strings/
scratch/

# Metadados internos e caches
.agents/
.pytest_cache/
__pycache__/
*.py[cod]
*$py.class
*.log
uninst_ptbr/
tests/test_results.json
